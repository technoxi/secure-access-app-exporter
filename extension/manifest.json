{
  "manifest_version": 3,
  "name": "Secure Access Application Exporter",
  "version": "0.1.0",
  "description": "Download Cisco Secure Access applications, application categories and application lists as JSON from your dashboard session.",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "permissions": ["scripting", "downloads", "tabs"],
  "host_permissions": [
    "https://dashboard.sse.cisco.com/*",
    "https://*.sse.cisco.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  }
}
